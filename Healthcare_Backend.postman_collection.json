            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Robert Paulson Jr.\",\n  \"age\": 43,\n  \"gender\": \"Male\",\n  \"contact_number\": \"+1-555-0199\",\n  \"email\": \"robert.paulson@example.com\",\n  \"address\": \"789 Oak Ave, Springfield\",\n  \"medical_history\": \"Hypertension controlled with medication\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/patients/{{patient_id}}/",
